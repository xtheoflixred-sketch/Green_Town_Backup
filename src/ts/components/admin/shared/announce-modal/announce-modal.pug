ng-template(#template)
	.modal-header.d-flex.justify-content-between.align-items-center
		h4.modal-title
			fa-icon.mr-2([icon]="faBullhorn" [fixedWidth]="true")
			| Send global announcement
		button.close(type="button" (click)="cancel()") ×

	.modal-body.announce-modal-body
		.form-group
			label Message
			textarea.form-control(rows="5" [(ngModel)]="message" placeholder="Write the announcement text here...")
			.text-muted.mt-2
				| This message will be sent to all connected players.

		.form-group
			label Destination
			.announce-type-grid
				button.btn.btn-outline-secondary.announce-type-option(
					type="button"
					*ngFor="let option of typeOptions"
					[class.active]="announceType === option.value"
					(click)="onAnnounceTypeChange(option.value)"
				)
					.d-flex.align-items-center
						fa-icon.mr-2([icon]="option.icon" [fixedWidth]="true")
						.d-flex.flex-column
							strong {{ option.label }}
							small.text-muted {{ option.description }}

		.form-group.mt-3
			label Alert type
			.announce-alert-grid
				button.btn.btn-outline-secondary.announce-alert-option(
					type="button"
					*ngFor="let option of alertTypes"
					[class.active]="alertType === option.value"
					[disabled]="isAlertTypeDisabled(option.value)"
					(click)="onAlertTypeChange(option.value)"
				)
					.d-flex.align-items-center
						fa-icon.mr-2([icon]="option.icon" [fixedWidth]="true")
						.d-flex.flex-column
							strong {{ option.label }}
							small.text-muted {{ option.description }}

		.announce-preview-card.mt-3
			.d-flex.justify-content-between.align-items-center.mb-2
				strong Preview
				span.text-muted {{ alertTitle() }}
			.alert([ngClass]="alertClass()" role="alert")
				fa-icon.alert-icon([icon]="alertIcon()" size="2x" [fixedWidth]="true")
				.alert-content
					strong.alert-title {{ alertTitle() }}
					.alert-message {{ message || 'No announcement text entered yet.' }}
			.text-muted.mt-2
				| This is a live preview. The final appearance depends on the alert styling used by the game.

	.modal-footer.justify-content-end
		button.btn.btn-outline-secondary(type="button" (click)="cancel()") Cancel
		button.btn.btn-primary.ml-2(type="button" (click)="send()" [disabled]="!canSend()") Send

