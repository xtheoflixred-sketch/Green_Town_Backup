ng-template(#template)
	.modal-header.d-flex.justify-content-between.align-items-center
		h4.modal-title Default server pony
		button.close(type="button" (click)="cancel()") ×

	.modal-body.default-pony-modal-body
		.default-pony-panel.default-pony-preview
			.preview-card
				.preview-card-label Preview
				.preview-wrapper(*ngIf="preview; else noPreview")
					character-preview([pony]="preview" [scale]="3")
				ng-template(#noPreview)
					.preview-empty
						strong {{ previewError ? 'Preview unavailable' : 'No pony preview available yet.' }}
						p.text-muted.mb-0
							| Paste a compressed pony string to preview it on the left.

		.default-pony-panel.default-pony-input
			.input-card
				.input-card-header Compressed pony string
				textarea.form-control(rows="10" (input)="updatePreview()" [(ngModel)]="inputValue")
				.text-muted.mt-2
					| Paste or edit the compressed pony string used for the default server character.
			.alert.alert-info.mt-3(role="alert")
				fa-icon.alert-icon([icon]="infoIcon" size="2x" [fixedWidth]="true")
				.alert-content
					.alert-title Внимание:
					.alert-message
						| Сохранение и публикация сразу применит этот дефолт для новых подключений.
				.alert.alert-warning.mt-3(*ngIf="previewError" role="alert")
				fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
				.alert-content
					.alert-title Warning:
					.alert-message
						| {{ previewError }}

	.modal-footer.justify-content-end
		button.btn.btn-outline-secondary(type="button" (click)="cancel()") Cancel
		button.btn.btn-primary.ml-2(type="button" (click)="importFile.click()") Import pony file
		input.d-none(#importFile type="file" accept=".txt" (change)="importPonyFile(importFile.files[0])")
		button.btn.btn-primary.ml-2(type="button" (click)="saveDefault()" [disabled]="!canImport()") Save as default
		button.btn.btn-success.ml-2(type="button" (click)="saveAndPublic()" [disabled]="!canImport()") Save And Publish
