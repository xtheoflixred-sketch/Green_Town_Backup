button.btn.btn-lg.btn-tiktok.btn-outline-dark.btn-block.mb-2(
	*ngIf="enableVisitTiktokButton"
	[class.nudging]="isNudging"
	(mouseenter)="pony.select(); onInteract()"
	(mouseout)="pony.reset()"
	(click)="openLeaveModal(); onInteract()"
	type="button")
	.tiktok-logo
		fa-icon([icon]="tiktokIcon")
	| {{'Visit TikTok!'}}
	.tiktok-pony
		tiktok-pony(#pony [scale]="2")

ng-template(#leaveSiteModal)
	leave-site-modal([title]="'Are you sure?'" [link]="tiktokLink" [buttonLabel]="'Yes, leave'" (close)="closeLeaveModal()" (confirm)="confirmLeave()")
