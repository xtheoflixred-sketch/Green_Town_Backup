button.action-button(
	(click)="click()" [class.active]="active" [class.no-shadow]="!shadow" [class.rare-item]="rare"
	[tooltip]="tooltipText || (action && action.title || '')"
	[placement]="tooltipPlacement"
	[containerClass]="tooltipClass"
	container="body")
	canvas(#canvas width="29" height="29")
	.shortcut {{shortcut}}
	.count(*ngIf="action && action.type === 'item'") {{action.count}}
	.cover
