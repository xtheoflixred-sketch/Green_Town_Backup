.mock-login-create-backdrop([class.show]="show")
  .mock-login-modal.create-account-modal([class.show]="show")
    .modal-header.d-sm-block
      h4.modal-title.d-flex.justify-content-between.w-100
        | Create account
        button.px-2(type='button' aria-label='Close' (click)='onClose()')
          span(aria-hidden='true') ×

    .modal-body.text-large
      .form-group
        label Account name
        input.form-control(type='text' [(ngModel)]='createAccountName' placeholder='Enter account name')
      .form-group
        label Birth date
        date-picker([(date)]='createBirthday')
      .form-group
        label Pony name
        input.form-control(type='text' [(ngModel)]='createPonyName' placeholder='Enter pony name (optional)')

      .pony-preview-card.mt-3
        label Preview
        .preview-wrapper
          character-preview(
            [pony]='getPreviewPony()'
            [name]='getPreviewName()'
            [noBackground]='true'
            [scale]='3'
            [namePlateOffsetY]='1'
            [namePlateTextY]='11'
            [tagOnlyNamePlateOffsetY]='1'
            [tagOnlyNamePlateTextY]='11'
          )
        .info-alert
          fa-icon([icon]='infoIcon')
          .info-alert-copy
            p.info-alert-title Account will not be linked to social login
            p.info-alert-text This account will be created without social login, and its future id will be: {{ futureId }}

      .error.text-danger(*ngIf='createError') {{ createError }}

    .modal-footer.d-flex
      button.btn.btn-outline-secondary(type='button' (click)='onClose()') Cancel
      button.btn.btn-info(type='button' (click)='submitCreateAccount()' [disabled]='createLoading || !createAccountName.trim() || !createBirthday') Create and login
