.sr-only(#ariaAnnounce aria-live="assertive")

.character-list([class.character-list-searchable]="searchable" [class.in-game]="inGame")

	.dropdown.character-select-search.input-group(
		[class.has-supporter-icon]="getSupporterLevel() > 0"
		(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
		(click)="$event.stopPropagation()" (keydown)="keydown($event)")
		span.search-supporter-icon(*ngIf="getSupporterLevel() > 0" title="Supporter Tier {{getSupporterLevel()}}")
			fa-icon([icon]="starIcon" [fixedWidth]="true" [style.color]="getSupporterStarColor()")
		input.form-control(
			#searchInput type="search" [placeholder]="placeholder" [(ngModel)]="search" (input)="updatePonies()"
			autocomplete="nope")
		.input-group-append
			.dropdown(dropdown #tagsDropdown="ag-dropdown" *ngIf="tags.length")
				button.btn.btn-secondary.character-hashtag-button(
					type="button"
					dropdownToggle
					title="Search by tags"
					(click)="$event.stopPropagation()")
					fa-icon([icon]="hashIcon")
				.dropdown-menu.dropdown-menu-right.shadow.tag-list(*dropdownMenu)
					ng-container(*ngIf="tags.length")
						button.dropdown-item(
							*ngFor="let tag of tags"
							(click)="search = tag; tagsDropdown.close(); updatePonies(); $event.stopPropagation()")
							| {{tag}}

			button.btn.btn-secondary(
				type="button"
				*ngIf="inGame"
				(click)="editCharacter.emit(); $event.stopPropagation()"
				title="Edit character"
				[ngClass]="{ 'btn-no-round-left': !tags.length, 'btn-no-round': tags.length }")
				fa-icon([icon]="editIcon")

			.dropdown(dropdown #sortDropdown="ag-dropdown")
				button.btn.btn-secondary.btn-no-round-left(
					type="button"
					dropdownToggle
					title="Sort options"
					(click)="$event.stopPropagation()")
					fa-icon([icon]="ellipsisIcon")
				.dropdown-menu.dropdown-menu-right.shadow(*dropdownMenu)
					div.dropdown-header Sort by
					button.dropdown-item(
						type="button"
						[class.active]="sortMode==='default'"
						(click)="setSortMode('default'); sortDropdown.close(); $event.stopPropagation()")
						| Default
					button.dropdown-item(
						type="button"
						[class.active]="sortMode==='name'"
						(click)="setSortMode('name'); sortDropdown.close(); $event.stopPropagation()")
						| Name
					button.dropdown-item(
						type="button"
						[class.active]="sortMode==='creation'"
						(click)="setSortMode('creation'); sortDropdown.close(); $event.stopPropagation()")
						| Creation date
					button.dropdown-item(
						type="button"
						[class.active]="sortMode==='recent'"
						(click)="setSortMode('recent'); sortDropdown.close(); $event.stopPropagation()")
						| Recently played

ul.character-select-list(
	role="listbox"
	[attr.aria-activedescendant]="'pony-item-' + selectedIndex")

	li(
		*ngFor="let p of ponies; let i = index; trackBy: trackByPony"
		[id]="'pony-item-' + i"
		[class.active]="i === selectedIndex"
		[class.selected]="p?.id === selectedPony?.id"
		[class.selected-line]="i === selectedIndex")

		a.item-list-divider(
			role="option"
			(click)="select(p)"
			(mouseenter)="setPreview(p)"
			(mouseleave)="unsetPreview(p)")

			portrait-box.me-2(
				[pony]="toPalette(p.ponyInfo || createDefaultPony())"
				size="small"
				[noBorder]="true")

			div.entry-with-text.flex-grow-1
				div.d-flex.align-items-center
					span.character-name.text-truncate(title="{{p.name}}") {{p.name}}

					span.char-timestamp.text-muted(
						*ngIf="sortMode==='recent' && p.lastUsed")
						|   ({{ formatLastUsed(p.lastUsed) }})

					span.char-timestamp.text-muted(
						*ngIf="sortMode==='creation'")
						|   ({{ formatCreated(p) }})

				div.character-desc.text-muted(title="{{p.desc}}")
					ng-container(
						*ngFor="let word of (p.desc || '').split(' '); let last = last")
						span(*ngIf="isTag(word)" class="character-desc-tag")
							| {{word}}
						span(*ngIf="!isTag(word)")
							| {{word}}
						span(*ngIf="!last")
							|  

			div.character-list-badges
				div.character-list-badges-main

					//- Supporter + социальная сеть на одной строке
					div.character-supporter-social

						//- Supporter Level
						ng-container(*ngIf="getSupporterTag(p) as supporterTag")

							//- Supporter tag скрыт пользователем
							div(
								*ngIf="supporterTag === 'hidden'"
								[tooltip]="'Supporter tag hidden'"
								placement="top"
								class="supporter-hidden-wrapper")
								fa-icon(
									[icon]="starIcon"
									[fixedWidth]="true"
									[style.color]="'#999'"
									[style.opacity]="'0.5'")
								fa-icon(
									[icon]="slashIcon"
									[fixedWidth]="true"
									class="supporter-hidden-slash"
									[style.color]="'#999'"
									[style.opacity]="'0.5'")

							//- Обычный Supporter Level
							div(
								*ngIf="supporterTag !== 'hidden'"
								class="supporter-tag-badge"
								[ngClass]="'supporter-tag-badge-' + getSupporterTagLevel(supporterTag)"
								[tooltip]="'Supporter tag: ' + supporterTag"
								placement="top")
								fa-icon(
									[icon]="starIcon"
									[fixedWidth]="true"
									[style.color]="getSupporterTagColor(supporterTag)")
								span
									| {{ supporterTag }}

						//- Социальная сеть персонажа
						div.site-icon-wrapper(
							*ngIf="getSocialSite(p) as site"
							[tooltip]="site.name"
							placement="top"
							containerClass="tooltip-site")
							fa-icon(
								[icon]="getProviderIcon(site.icon || '')"
								[fixedWidth]="true"
								[style.color]="site.color")

					//- Тег персонажа (dev/mod) на отдельной строке
					ng-container(*ngIf="getCharacterTag(p) as tag")
						span.badge.character-tag-badge(
							[ngClass]="'badge-' + tag.className"
							[tooltip]="getCharacterTagTooltip(p)"
							placement="top")
							fa-icon(
								*ngIf="tag.icon"
								[icon]="tag.icon"
								[fixedWidth]="true")
							span(*ngIf="!tag.icon")
								| {{ tag.id }}

	li(*ngIf="canNew")
		a.text-center(
			role="option"
			(click)="createNew()")
			em new pony