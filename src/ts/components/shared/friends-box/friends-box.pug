.friends-box.dropdown(
	dropdown #dropdown="ag-dropdown" autoClose="outsideClick" (isOpenChange)="toggle()" [hookToCanvas]="true" [focusOnOpen]="false")
	button.game-button.dropdown-toggle.no-arrow(dropdownToggle (click)="false" title="Friends")
		fa-icon([icon]="friendsIcon" [fixedWidth]="true")
	.friends-dropdown-menu.dropdown-menu.dropdown-menu-right(*dropdownMenu)
		.dropdown.character-select-search.input-group.rounded-0(
			[class.has-supporter-icon]="getSupporterLevel() > 0"
			(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
			(click)="$event.stopPropagation()" (keydown)="$event.stopPropagation()")
			span.friend-search-supporter-icon(*ngIf="getSupporterLevel() > 0" title="Supporter Tier {{getSupporterLevel()}}")
				fa-icon([icon]="faStar" [fixedWidth]="true" [style.color]="getSupporterStarColor()")
			input.form-control.rounded-0(
				#searchInput type="search" [placeholder]="placeholder" [(ngModel)]="search"
				autocomplete="nope" (input)="updateFriends()")
			.input-group-append
				button.btn.btn-secondary.btn-no-round-left(type="button" *ngIf="search" title="Clear search" (click)="search = ''; updateFriends(); $event.stopPropagation()")
					| ×
				.dropdown(dropdown #settingsDropdown="ag-dropdown")
					button.btn.btn-secondary.btn-no-round-left(type="button" dropdownToggle title="Friends settings" (click)="$event.stopPropagation()")
						fa-icon([icon]="cogIcon")
					.dropdown-menu.dropdown-menu-right.shadow(*dropdownMenu)
						button.dropdown-item.padded(type="button" (click)="$event.stopPropagation(); toggleHidden(); settingsDropdown.close()")
							fa-icon([icon]="faCheck", [class]="hidden ? '' : 'text-muted'")
							|  Show as offline
							p.small.text-muted.friend-list-status-item
								| Show your status as offline in the friend list,
								br
								| and hide your friend tag and name color.
						div.dropdown-divider
						button.dropdown-item.padded(type="button" (click)="$event.stopPropagation(); setSortMode('status'); settingsDropdown.close()")
							fa-icon([icon]="faCheck", [class]="sortMode === 'status' ? '' : 'text-muted'")
							|  Sort by status
						button.dropdown-item.padded(type="button" (click)="$event.stopPropagation(); setSortMode('name'); settingsDropdown.close()")
							fa-icon([icon]="faCheck", [class]="sortMode === 'name' ? '' : 'text-muted'")
							|  Sort by account name
						button.dropdown-item.padded(type="button" (click)="$event.stopPropagation(); setSortMode('default'); settingsDropdown.close()")
							fa-icon([icon]="faCheck", [class]="sortMode === 'default' ? '' : 'text-muted'")
							|  Sort by character name
		.friends-list(*ngIf="!isUpdating && filteredFriends && filteredFriends.length; else updatingOrNoFriends")
			.small.text-muted.px-2.py-1(*ngIf="search")
				| {{filteredFriends.length}} result{{filteredFriends.length === 1 ? '' : 's'}}
			button.section-button.friends-section-header.w-100.d-flex.align-items-center.px-3.py-2.font-weight-bold(
				type="button"
				title="Toggle pinned friends"
				(click)="togglePinnedSection(); $event.stopPropagation()"
				*ngIf="pinnedFriends && pinnedFriends.length > 0"
				style="width: 100%; height: 44px; min-height: 44px; padding: 0 12px; background: rgba(0, 0, 0, 0.08); border-top: 1px solid rgba(255, 255, 255, 0.06); border-bottom: 1px solid rgba(0, 0, 0, 0.12);"
			)
				fa-icon.mr-2.pointer-none.text-muted([icon]="showPinnedSection ? faChevronDown : faChevronRight")
				span.friends-section-icon.d-inline-flex.align-items-center.justify-content-center.mr-2.text-muted(style="width: 18px;")
					fa-icon([icon]="faThumbtack")
				span.friends-section-title.flex-grow-1.text-left.font-weight-bold(style="font-size: 14px;") Pinned
				span.friends-section-count.text-muted.ml-auto.text-nowrap(style="font-size: 13px;")
					| ({{pinnedFriends.length}})
			ng-container(*ngIf="showPinnedSection")
				ng-container(*ngFor="let f of pinnedFriends; let i = index; trackBy: trackByFriendId")
					ng-container(*ngTemplateOutlet="friendItem; context: { $implicit: f, isFirstFriend: i === 0 }")
			button.section-button.friends-section-header.w-100.d-flex.align-items-center.px-3.py-2.font-weight-bold(
				type="button"
				title="Toggle general friends"
				(click)="toggleGeneralSection(); $event.stopPropagation()"
				*ngIf="generalFriends && generalFriends.length > 0"
				style="width: 100%; height: 44px; min-height: 44px; padding: 0 12px; background: rgba(0, 0, 0, 0.08); border-top: 1px solid rgba(255, 255, 255, 0.06); border-bottom: 1px solid rgba(0, 0, 0, 0.12);"
			)
				fa-icon.mr-2.pointer-none.text-muted([icon]="showGeneralSection ? faChevronDown : faChevronRight")
				span.friends-section-icon.d-inline-flex.align-items-center.justify-content-center.mr-2.text-muted(style="width: 18px;")
					fa-icon([icon]="faUserCircle")
				span.friends-section-title.flex-grow-1.text-left.font-weight-bold(style="font-size: 14px;") General
				span.friends-section-count.text-muted.ml-auto.text-nowrap(style="font-size: 13px;")
					| ({{generalFriends.length}})
			ng-container(*ngIf="showGeneralSection")
				ng-container(*ngFor="let f of generalFriends; let i = index; trackBy: trackByFriendId")
					ng-container(*ngTemplateOutlet="friendItem; context: { $implicit: f, isFirstFriend: i === 0 && (!pinnedFriends || !pinnedFriends.length || !showPinnedSection) }")
			ng-template(#friendItem let-f let-isFirstFriend="isFirstFriend")
				.friends-item(
					dropdown
					[ngClass]="f.online ? 'online' : 'offline'"
					[useOutlet]="true"
					[hookToCanvas]="true"
					[focusOnOpen]="false"
					[focusOnClose]="false"
					autoClose="outsideClick")
					button.d-flex(type="button" dropdownToggle [title]="f.actualName + ' — ' + (f.online ? 'online' : (formatLastSeen(f.lastSeen) || 'offline'))")
						portrait-box.mr-2([pony]="f.ponyInfo" size="small" [noBorder]="true")
						.flex-grow-1.friends-item-details.min-width-0
							.d-flex.align-items-center.justify-content-between.gap-2.min-width-0
								.friends-item-name.text-truncate.min-width-0.flex-grow-1 {{f.actualName}}
								.d-inline-flex.align-items-center.flex-shrink-0.gap-2
									span.text-muted(*ngIf="getNote(f)" [title]="isFirstFriend ? getNote(f) : 'Note'" [tooltip]="isFirstFriend ? null : getNote(f)")
										fa-icon([icon]="faStickyNote")
									span.text-muted(*ngIf="isShownOfflineForFriend(f)" [tooltip]="'You appear offline only for this friend'" title="Show as offline for this friend")
										fa-icon([icon]="faEyeSlash")
									span.text-muted(*ngIf="isPinned(f)" [title]="isFirstFriend ? 'Pinned' : null" [tooltip]="isFirstFriend ? null : 'Pinned'")
										fa-icon([icon]="faThumbtack")
							.friends-item-more.d-flex.align-items-center.justify-content-between
								.text-muted.friends-item-account.text-truncate {{f.accountName}}
								.d-inline-flex.align-items-center.flex-shrink-0.gap-2
									span.text-success(*ngIf="f.online") online
									span.text-muted(*ngIf="!f.online") {{formatLastSeen(f.lastSeen) || 'offline'}}
									span.text-muted(*ngIf="isInParty(f)" title="In party")
										fa-icon([icon]="faUserCheck")
									button.btn-outline-whisper.btn-link.btn-sm.p-0.border-0.shadow-none.friend-whisper-button(
										*ngIf="f.online"
										type="button"
										title="Send whisper"
										(click)="sendMessageTo(f); $event.stopPropagation()"
										style="border: 0; background: transparent; box-shadow: none; padding: 0;")
										fa-icon.friend-action-icon-whisper([icon]="faComment")
					.options-dropdown-menu.pony-menu.dropdown-menu.shadow(
						*dropdownMenu
						(mousedown)="$event.stopPropagation()"
						(mouseup)="$event.stopPropagation()"
						(click)="$event.stopPropagation()"
						(keydown)="$event.stopPropagation()"
						(focusin)="$event.stopPropagation()"
						style="max-height: 420px; overflow-y: auto; position: relative;")
						span(
							style="position: absolute; top: 0; left: 18px; width: 0; height: 0; transform: translateY(-1px); border-left: 7px solid transparent; border-right: 7px solid transparent; border-bottom: 7px solid #fff; pointer-events: none; z-index: 3;")
						div.pony-menu-name.py-1.px-2(style="padding-top: 5px;")
							div.name-text.text-truncate(title="{{f.actualName}}") {{f.actualName}}
							div.name-badges.d-flex.gap-1.ms-auto
								span.badge.badge-success(title="Friend")
									fa-icon([icon]="faUserCheck")
								span.badge.badge-secondary(title="Show as offline only for this friend" *ngIf="isShownOfflineForFriend(f)")
									fa-icon([icon]="faEyeSlash")
								span.badge.badge-success(title="Pinned" *ngIf="isPinned(f)")
									fa-icon([icon]="faThumbtack")
								span.badge.badge-secondary(title="Offline" *ngIf="!f.online")
									fa-icon([icon]="faPlug")
						.d-flex.align-items-center.px-2.py-1(*ngIf="getNote(f)")
							span.text-muted.mr-2
								fa-icon([icon]="faStickyNote")
							span.text-muted.text-truncate(title="{{getNote(f)}}") {{getNote(f)}}
						.d-flex.gap-1.px-1.py-1(*ngIf="editingNoteFor !== f.accountId")
							button.btn.btn-sm.btn-outline-secondary.flex-grow-1(type="button" title="View profile" [disabled]="!f.online" (click)="showProfileFor(f)")
								fa-icon.me-1([icon]="faUserCircle")
								| Profile
							button.btn.btn-sm.btn-outline-info.flex-grow-1(type="button" *ngIf="!getNote(f)" title="Add friend note" (click)="startEditNote(f); $event.stopPropagation()")
								fa-icon.me-1([icon]="faStickyNote")
								| Note
							ng-container(*ngIf="getNote(f)")
								button.btn.btn-sm.btn-outline-info.flex-grow-1(type="button" title="Edit friend note" (click)="startEditNote(f); $event.stopPropagation()")
									fa-icon.me-1([icon]="faStickyNote")
									| Edit
								button.btn.btn-sm.btn-outline-danger.flex-grow-1(type="button" title="Remove friend note" (click)="startRemoveNote(f); $event.stopPropagation()")
									fa-icon.me-1([icon]="faUserMinus")
									| Remove
						div.px-2.py-1(*ngIf="editingNoteFor === f.accountId && editingNoteMode === 'edit'")
							textarea.form-control.rounded-0.mb-1(
								(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
								(click)="$event.stopPropagation()" (keydown)="$event.stopPropagation()"
								[(ngModel)]="editingNoteText"
								[attr.placeholder]="'Note (0-100 characters)'"
								maxlength="100"
								rows="3")
							.d-flex.gap-1
								button.btn.btn-sm.btn-outline-danger.flex-grow-1(
									(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
									(click)="cancelEditNote(); $event.stopPropagation()")
									| Cancel
								button.btn.btn-sm.btn-outline-success.flex-grow-1(
									(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
									(click)="saveNote(f); $event.stopPropagation()")
									| Save
							.small.text-muted.mt-1
								| {{editingNoteText.length}}/100
						.d-flex.gap-1.px-1.py-1(*ngIf="editingNoteFor === f.accountId && editingNoteMode === 'remove'")
							button.btn.btn-sm.btn-outline-success.flex-grow-1(
								(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
								(click)="cancelRemoveNote(); $event.stopPropagation()")
								| Cancel
							button.btn.btn-sm.btn-outline-danger.flex-grow-1(
								(mousedown)="$event.stopPropagation()" (mouseup)="$event.stopPropagation()"
								(click)="confirmRemoveNote(); $event.stopPropagation()")
								| Confirm
						.d-flex.gap-1.px-1.py-1(*ngIf="editingNoteFor !== f.accountId")
							button.btn.btn-sm.btn-outline-secondary.flex-grow-1(type="button" [disabled]="!f.online" title="Invite or remove from party" (click)="inviteToParty(f); $event.stopPropagation()")
								fa-icon.me-1.friend-action-icon-party([icon]="addToPartyIcon")
								| {{isInParty(f) ? 'Leave party' : 'Party'}}
							button.btn.btn-sm.btn-outline-secondary.flex-grow-1(type="button" [disabled]="!f.online" title="Send whisper" (click)="sendMessageTo(f); $event.stopPropagation()")
								fa-icon.me-1.friend-action-icon-whisper([icon]="faComment")
								| Whisper
						.d-flex.gap-1.px-1.py-1(*ngIf="editingNoteFor !== f.accountId")
							button.btn.btn-sm.btn-outline-secondary.flex-grow-1(
								type="button"
								[disabled]="isReallyOffline(f)"
								title="{{isShownOfflineForFriend(f) ? 'Disable show as offline' : 'Enable show as offline'}}"
								(click)="toggleShowAsOfflineForFriend(f); $event.stopPropagation()")
								fa-icon.me-1([icon]="faEyeSlash" [class]="isShownOfflineForFriend(f) ? '' : 'text-muted'")
								| {{isShownOfflineForFriend(f) ? 'Offline off' : 'Offline'}}
							button.btn.btn-sm.btn-outline-secondary.flex-grow-1(
								type="button"
								title="{{isPinned(f) ? 'Unpin in friend list' : 'Pin in friend list'}}"
								(click)="togglePin(f); $event.stopPropagation()")
								fa-icon.me-1([icon]="faThumbtack")
								| {{isPinned(f) ? 'Unpin' : 'Pin'}}
						.d-flex.gap-1.px-1.py-1(*ngIf="removing === f")
							button.btn.btn-sm.btn-outline-success.flex-grow-1((click)="cancelRemove(); $event.stopPropagation()")
								| Cancel
							button.btn.btn-sm.btn-outline-danger.flex-grow-1((click)="confirmRemove(); $event.stopPropagation()")
								| Confirm
						button.btn.btn-sm.btn-outline-danger.w-100(type="button" (click)="remove(f); $event.stopPropagation()" *ngIf="removing !== f" title="Remove from friends")
								fa-icon.me-1.text-danger([icon]="faUserMinus")
								| Remove friend
	ng-template(#updatingOrNoFriends)
		.text-center.text-muted.p-3(*ngIf="isUpdating")
			| Updating friends...
		.text-center.text-muted.p-2(*ngIf="!friends")
			| Loading...
		.text-center.text-muted.p-3(*ngIf="friends && !filteredFriends.length")
			div.mb-1 No friends found
			.small Select a player and use #[fa-icon([icon]="userOptionsIcon")] to add them to your friends.



