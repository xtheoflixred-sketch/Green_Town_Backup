.modal-header.text-center
	h4.modal-title Toys

.modal-body
	.preview-section.mb-3.text-center
		square-portrait-box([pony]="previewPony" size="large" noBorder="true")

	-// Toy collection stats
	.stats.mb-3.text-center
		div.stat-line {{getCollectedCount()}} / {{toys.length}} toys collected

	-// Toy selection using set-selection pattern
	.toys-container
		.row.form-group
			label.col-sm-12.text-center.col-form-label.text-muted Select a toy
		.row.form-group
			.col-sm-12
				set-selection(
					[set]="toySet"
					[sets]="toySets"
					[empty]="true"
					[disabledItems]="disabledToys"
					[darken]="false"
					(change)="onToySetChanged()"
				)

.modal-footer
	button.btn.btn-wide.btn-outline-secondary(type='button' (click)='closeModal()') Close
	button.btn.btn-wide.btn-primary(type='button' (click)='confirmSelection()') Confirm

