.chat-box(#chatBox (mousedown)="onChatBoxMouseDown($event)" (click)="onChatBoxClick($event)")
	div(#chatBoxInput)
		.command-dropdown(*ngIf="showCommandDropdown")
			ul.command-dropdown-menu(*ngIf="!tobeMode && !isSubcommandMode")
				ng-container(*ngFor="let group of filteredCommandGroups")
					li.command-dropdown-category {{group.category}}
					li.command-dropdown-item(*ngFor="let cmd of group.commands" [class.active]="isSelectedCommand(cmd)" (click)="selectCommand(cmd)")
						| /{{cmd.name}}
						span.command-help(*ngIf="cmd.help") {{cmd.help}}
				li.command-dropdown-empty(*ngIf="filteredCommands.length === 0")
					i команды не найдены

			ul.command-dropdown-menu(*ngIf="!tobeMode && isSubcommandMode")
				li.command-dropdown-item(*ngFor="let subcommand of filteredSubcommands; let i = index" [class.active]="selectedSubcommandIndex === i" (click)="selectSubcommand(subcommand)")
					| {{subcommand}}
				li.command-dropdown-empty(*ngIf="filteredSubcommands.length === 0")
					i подкоманды не найдены

			ul.command-dropdown-menu(*ngIf="tobeMode")
				li.command-dropdown-item(*ngFor="let entity of filteredTobeEntities; let i = index" [class.active]="selectedTobeIndex === i" (click)="selectTobeEntity(entity)")
					| {{entity}}
				li.command-dropdown-empty(*ngIf="filteredTobeEntities.length === 0")
					i команды не найдены

			ul.command-dropdown-menu(*ngIf="seasonMode")
				li.command-dropdown-item(
					*ngFor="let item of filteredSeasonItems; let i = index",
					[class.active]="selectedSeasonIndex === i",
					(click)="selectSeasonItem(item)"
				)
					| {{item}}
				li.command-dropdown-empty(*ngIf="filteredSeasonItems.length === 0")
					i no matches

		.toy-dropdown(*ngIf="showToyDropdown")
			.toy-dropdown-menu
				li.toy-dropdown-item(
					*ngFor="let toy of filteredToys",
					[class.toy-collected]="isToyCollected(toy.id)",
					[class.toy-uncollected]="!isToyCollected(toy.id)",
					(click)="selectToyById(toy.id)"
				)
					span.toy-icon-frame
						sprite-box(
							*ngIf="getToyPreview(toy.id)"
							[sprite]="getToyPreview(toy.id)"
							size="30"
							scale="1"
							[darken]="false"
						)
					span.toy-name {{toy.name}}
					span.toy-number {{ '#' + toy.id }}

		.msgcolor-picker(*ngIf="showColorPicker" [ngStyle]="colorPickerStyle")
			color-picker([color]="msgColor" [isOpen]="showColorPicker" (colorChange)="onColorChange($event)" openUp)

		.chat-markdown-toolbar(
			*ngIf="showMarkdownToolbar"
			[ngStyle]="markdownToolbarStyle"
			(mousedown)="$event.preventDefault(); $event.stopPropagation()"
			(click)="$event.stopPropagation()"
		)
			.chat-markdown-toolbar-actions
				button.chat-markdown-tool(
					type="button"
					title="Bold"
					aria-label="Bold"
					(click)="applyMarkdownWrap('**')"
				)
					strong B
				button.chat-markdown-tool(
					type="button"
					title="Italic"
					aria-label="Italic"
					(click)="applyMarkdownWrap('*')"
				)
					em I
				button.chat-markdown-tool(
					type="button"
					title="Strikethrough"
					aria-label="Strikethrough"
					(click)="applyMarkdownWrap('~~')"
				)
					del S
				button.chat-markdown-tool(
					type="button"
					title="Inline code"
					aria-label="Inline code"
					(click)="applyMarkdownWrap('`')"
				)
					| code
				button.chat-markdown-tool(
					type="button"
					title="Link"
					aria-label="Link"
					(click)="applyMarkdownLink()"
				)
					| 🔗

			.chat-markdown-preview(
				*ngIf="markdownPreviewHtml"
				[innerHTML]="markdownPreviewHtml"
			)

		.chat-input#chat-input(
			#inputElement
			contenteditable="true"
			spellcheck="false"
			tabindex="0"
			attr.data-placeholder="Chat message"
			(keydown)="onEditorKeydown($event)"
			(input)="onEditorInput($event)"
			(click)="onInputClick($event)"
			(mousedown)="onInputMouseDown($event)"
			(mouseup)="updateMarkdownSelection()"
			(keyup)="updateMarkdownSelection()"
			(blur)="onEditorBlur($event)"
			(paste)="onEditorPaste($event)"
			aria-label="Chat message"
		)

		.chat-box-type(
			#typeBox
			(click)="toggleChatType($event)"
			(contextmenu)="onChatTypeContextMenu($event)"
			(mousedown)="onTypeBoxPressStart($event)"
			(mouseup)="onTypeBoxPressEnd()"
			(mouseleave)="onTypeBoxPressEnd()"
			(touchstart)="onTypeBoxPressStart($event)"
			(touchend)="onTypeBoxPressEnd()"
		)
			| #[span(#typePrefix)][#[span.chat-box-type-name(#typeName)]]:

		.chat-type-menu(
			*ngIf="showChatTypeMenu"
			[ngStyle]="chatTypeMenuStyle"
			(mousedown)="$event.stopPropagation()"
			(click)="$event.stopPropagation()"
			(mouseleave)="clearChatTypePreview()"
		)
			ul
				ng-container(*ngFor="let option of chatTypeMenuOptions; let i = index")
					li.chat-type-divider(
						*ngIf="option.divider"
						(click)="toggleChatTypeCategory(option.category)"
						(mouseenter)="clearChatTypePreview()"
					)
						span.chat-type-category-arrow
							| {{ option.collapsed ? '▸' : '▾' }}
						span.chat-type-category-label
							| {{ option.label }}

					li(
						*ngIf="!option.divider && !option.hidden && option.mode !== undefined"
						[class.active]="selectedChatTypeIndex === option.selectableIndex"
						(click)="selectChatTypeByIndex(option.selectableIndex, option.mode)"
						(mouseenter)="onChatTypeMenuHover(option.mode)"
						[style.--say-color]="option.mode === chatType.Say ? msgColor : 'inherit'"
					)
						span.badge(
							[ngClass]="'badge-' + option.badgeClass"
							*ngIf="option.icon || option.badgeClass"
							[class.badge-say-colored]="option.mode === chatType.Say && msgColor !== '#bbbbbb'"
							[class.badge-think-dark]="option.mode === chatType.Think"
						)
						fa-icon.mr-1(*ngIf="option.icon" [icon]="option.icon" [fixedWidth]="true")
							| {{ option.label }}

		.chat-char-count(*ngIf="showRemainingCharacters" [class.danger]="remainingCharactersDanger") {{ remainingCharacters }}

		emoji-picker(
			[display]="emojiBoxState === 'inline-block'"
			resizeCorner="top-left"
			(emojiSelected)="addEmoji($event)"
			(closed)="emojiBoxState = 'none'"
			class="emoji-dropdown"
		)

		button.emote.game-button.chat-emoji-button(
			(click)="toggleEmojiBox()"
			(mouseenter)="onMouseEnterEmojiButton($event)"
			aria-label="Emojis"
			title="Emojis (use Control + E to open)"
		)
			emote-box([emote]="btnEmoji" [square]="true")

		button.game-button.chat-send-button(
			(click)="send($event)"
			title="Send message"
			aria-label="Send message"
		)
			fa-icon([icon]="sendIcon")

button.game-button.chat-open-button(
	(click)="toggle()"
	(mousedown)="$event.preventDefault()"
	[disabled]="disabled"
	title="Toggle chat"
	aria-label="Toggle message"
)
	fa-icon([icon]="commentIcon" [fixedWidth]="true")
