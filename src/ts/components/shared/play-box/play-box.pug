.form-group(*ngIf="hasTooManyPonies")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| You have more than the allowed number of {{characterLimit}} ponies, the additional ones may get deleted.
				| Remove some of your unused ponies to prevent losing the ones you want to keep.

.form-group(*ngIf="isMarkedForMultiples")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Your account has been flagged for creating multiple accounts.
				| Creating more accounts may result in a permanent ban.

.form-group(*ngIf="leftMessage")
	.alert([ngClass]="leftAlertClass" role="alert")
		fa-icon.alert-icon([icon]="alertIcon(leftAlertClass === 'alert-info' ? 'info' : 'warning')" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message {{leftMessage}}

.form-group(*ngIf="isAndroidBrowser")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Your browser is outdated and is not able to correctly run Green Town.
				| Please install a different browser to be able to play the game.

.form-group(*ngIf="model.missingBirthdate && !birthdateSet && requestBirthdate")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-title Set your date of birth
			.alert-message
				label(for="birthdate")
				date-picker([(date)]="birthdate")
				.mt-2.text-right
					button.btn.btn-default.px-4((click)="saveBirthdate()") Save
				p.mb-0.mt-2
					| Please fill-in your #[b date of birth] in order to not lose access to the game in future updates.

.form-group.dropdown(dropdown)
	.btn-group.d-flex
		button.btn.btn-lg.btn-success.text-ellipsis.flex-grow-1.play-action(
			#playButton (click)="play()" [disabled]="!canPlay || joining")
			.play-state-viewport
				.play-state-stack
					div.play-selected-content(*ngIf="!joining && server")
						.server-markers.server-markers-selected
							.flag(*ngFor="let f of server.countryFlags" [ngClass]="'flag-' + f")
							fa-icon.server-marker(*ngFor="let marker of getServerFlags(server)" [ngClass]="marker.className" [icon]="marker.icon" [fixedWidth]="true")
						.play-server-label
							strong {{label || 'Play'}}
							span.mx-1 on
							span([emojiText]="server.name")
					div.play-hover-content
						fa-icon.mr-2([icon]="playIcon")
						| Play
					div.play-empty-content(*ngIf="!joining && !server")
						fa-icon.mr-2([icon]="playIcon")
						| Play
					div.play-loading-content(*ngIf="joining")
						fa-icon.mr-2([icon]="spinnerIcon" [spin]="true")
						span Loading...
			.play-progress-inline(*ngIf="joining")
					fa-icon.play-progress-icon([icon]="loadingIcons[loadingIconIndex]" [fixedWidth]="true")
					.progress
						.progress-bar([style.width.%]="loadingProgress" role="progressbar" [attr.aria-valuenow]="loadingProgress" aria-valuemin="0" aria-valuemax="100")
		button.btn.btn-outline-light.btn-lg.play-cancel(*ngIf="joining" type="button" (click)="cancel()")
			| Cancel
		button.btn.btn-lg.btn-success.flex-grow-0.dropdown-toggle(
			dropdownToggle aria-label="select server" [disabled]="joining" style="position: relative")
	.dropdown-menu.w-100(*dropdownMenu style="overflow: hidden")
		button.dropdown-item(*ngFor="let s of servers" (click)="server = s; playButton.focus()")
			div
				.float-right(style="position: relative;")
					.text-unsafe(*ngIf="s.offline") #[span.sr-only server] offline
					.text-muted(*ngIf="!s.offline") online #[span.sr-only players] ({{s.online}})
				.server-markers
					.flag(*ngFor="let f of s.countryFlags" [ngClass]="'flag-' + f")
					fa-icon.server-marker(*ngFor="let marker of getServerFlags(s)" [ngClass]="marker.className" [icon]="marker.icon" [fixedWidth]="true")
					fa-icon.server-marker.text-muted(*ngIf="!hasFlag(s) && !getServerFlags(s).length" [icon]="getIcon(s)" size="lg" [fixedWidth]="true")
				strong([emojiText]="s.name")
			.text-muted.text-wrap {{s.desc}}

.form-group(*ngIf="server?.alert === '18+'")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-title Mature Content Warning
			.alert-message
				| By playing on this server you confirm that you are over 18 years old and you take no issue
				| with seeing adult topics.

.form-group(*ngIf="server?.alert === 'test'")
	.alert.alert-info(role="alert")
		fa-icon.alert-icon([icon]="infoIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-title Supporter Test Server
			.alert-message
				| Here you can try experimental and unfinished features that we're working on.
				| Keep in mind everything is subject to change.

.form-group(*ngIf="isDevOrTestServer")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-title Development/Test Server
			.alert-message
				| This server is intended for development and testing. Features may be unfinished,
				| unstable, or changed without notice.

.form-group(*ngIf="server?.offline")
	.alert.alert-info(role="alert")
		fa-icon.alert-icon([icon]="infoIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Selected server is offline, try again later

.form-group(*ngIf="offline")
	.alert.alert-info(role="alert")
		fa-icon.alert-icon([icon]="infoIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Server is offline, try again later

.form-group(*ngIf="protectionError && !offline")
	.alert.alert-info(role="alert")
		fa-icon.alert-icon([icon]="infoIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Cloudflare error, #[button.btn.btn-sm.btn-outline-default((click)="reload()") reload] to continue.

.form-group(*ngIf="updateWarning")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Server will restart shortly for updates and maintenance.
				| Save your character to avoid losing any progress.

.form-group(*ngIf="isBrowserOutdated")
	.alert.alert-warning(role="alert")
		fa-icon.alert-icon([icon]="warningIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Your browser is outdated and is known to have issues running Green Town.
				| Make sure you have latest version installed.
		button.close.ml-2((click)="dismissOutdatedBrowser()" aria-label="Close" style="font-size: 20px;") &times;

.form-group(*ngIf="invalidVersion && !offline")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Your client version is outdated, #[button.btn.btn-sm.btn-outline-default((click)="reload()") reload] to be able to play.

.form-group(*ngIf="isAccessError")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| You're no longer signed-in, #[button.btn.btn-sm.btn-outline-default((click)="reload()") reload] to be able to sign-in again.

.form-group(*ngIf="failedToLoadImages")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Failed to load game assets, #[button.btn.btn-sm.btn-outline-default((click)="hardReload()") reload] to retry.

.form-group(*ngIf="isWebGLError")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Failed to create WebGL context. Your graphics card drivers or browser are outdated or graphics
				| acceleration is disabled. Go to #[a.alert-link(href="http://webglreport.com/" tabindex) WebGL Report] to
				| check WebGL support in your browser.

.form-group(*ngIf="isBrowserError")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| Your browser is outdated, make sure you have the latest version installed.

.form-group(*ngIf="isOtherError")
	.alert.alert-danger(role="alert")
		fa-icon.alert-icon([icon]="dangerIcon" size="2x" [fixedWidth]="true")
		.alert-content
			.alert-message
				| {{error}}

.form-group.text-left.text-large(*ngIf="server")
	h5 Server rules
	p.text-muted.list-rules
		| {{server.desc}}
