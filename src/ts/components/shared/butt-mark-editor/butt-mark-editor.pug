.form-group.text-center
	label#butt-mark-label.text-muted Butt mark
.row.form-group(role="group" aria-labelledby="butt-mark-label")
	.col-12
		.d-flex.flex-wrap.align-items-center.justify-content-center.butt-mark-toolbar(style="gap: 6px;")
			.btn-group(role="group" aria-label="History")
				button.btn.btn-danger(type="button" (click)="clearCM()" title="Clear all")
					fa-icon([icon]="trashIcon" [fixedWidth]="true")
				button.btn.btn-outline-secondary(type="button" [disabled]="!canUndo" (click)="undo()" title="Undo")
					fa-icon([icon]="undoIcon" [fixedWidth]="true")
				button.btn.btn-outline-secondary(type="button" [disabled]="!canRedo" (click)="redo()" title="Redo")
					fa-icon([icon]="redoIcon" [fixedWidth]="true")
			.btn-group(btnRadioGroup [(ngModel)]="state.brushType" (ngModelChange)="rememberTool($event)" role="group" aria-label="Drawing tools")
				button.btn.btn-primary(btnRadio="eraser" title="Eraser")
					fa-icon([icon]="eraserIcon" [fixedWidth]="true")
				button.btn.btn-primary(btnRadio="eyedropper" title="Eyedropper")
					fa-icon([icon]="eyeDropperIcon" [fixedWidth]="true")
				button.btn.btn-primary(btnRadio="brush" title="Brush")
					fa-icon([icon]="paintBrushIcon" [fixedWidth]="true")
				button.btn.btn-primary(btnRadio="fill" title="Fill area")
					fa-icon([icon]="fillIcon" [fixedWidth]="true")
				button.btn.btn-primary(btnRadio="line" title="Draw line")
					fa-icon([icon]="lineIcon" [fixedWidth]="true")
				button.btn.btn-primary(btnRadio="rectangle" title="Draw rectangle")
					span.rectangle-tool-icon
.form-group.text-center
	.butt-mark-canvas-area((mousemove)="updateToolCursor($event)" (mouseleave)="hideToolCursor()")
		bitmap-box(
			#bitmapBox
			[bitmap]="info.cm"
			[tool]="state.brushType"
			[(color)]="state.brush"
			(colorChange)="pickedColor($event)"
			[width]="cmSize"
			[height]="cmSize"
			(editStart)="startEdit()"
			(bitmapChange)="finishEdit()"
			[baseColor]="showColoredBackground ? info.coatFill : 'ffffff'"
			[showBackground]="showColoredBackground"
		)
		span.butt-mark-tool-cursor(*ngIf="toolCursorVisible" [style.left.px]="toolCursorX" [style.top.px]="toolCursorY")
			span.rectangle-tool-icon(*ngIf="isRectangleTool")
			fa-icon(*ngIf="!isRectangleTool" [icon]="toolIcon" [fixedWidth]="true")
.form-group.d-flex.flex-column.align-items-center
	.color-picker-toolbar
		color-picker([(color)]="state.brush" (colorChange)="pickedColor($event)" label="Brush color")
	custom-checkbox([(checked)]="showColoredBackground")
		| Show coat color background
.form-group.d-flex.justify-content-center.align-items-center.text-muted
	custom-checkbox([(checked)]="info.cmFlip")
		| don't flip mark on the right side
