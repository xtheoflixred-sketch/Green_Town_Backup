ng-template(#signOutModal)
	sign-out-modal(
		[pony]="currentPony"
		[lastLogin]="lastLoginLabel"
		[lastLogout]="lastLogoutLabel"
		[signOutLoading]="signOutLoading"
		[signOutError]="signOutError"
		(close)="closeSignOutModal()"
		(confirm)="confirmSignOut()"
		[focusTrap]="true"
		(keydown)="$event.stopPropagation()"
	)

nav.navbar.navbar-expand.justify-content-end(role="navigation")
	.d-none.d-md-block
		a.pixelart.logo(*ngIf="logo" routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }")
			img.pixelart.logo-large(revSrc="images/logo-large.png" alt="Green Town" width="auto" height="auto")
			img.pixelart.logo-small(revSrc="images/logo-small.png" alt="Green Town" width="auto" height="auto")

	.navbar-collapse.text-right
		.navbar-nav.ml-auto
			ng-content

			.dropdown(*ngIf="account" #dropdown="ag-dropdown" dropdown autoClose="outsideClick")
				button.btn.cursor-pointer.dropdown-toggle(
					dropdownToggle
					[attr.aria-label]="'Signed-in as ' + account.name"
				)
					fa-icon.mr-1(
						*ngIf="hasSupporterIcon"
						[icon]="starIcon"
						[ngClass]="supporterClass"
						[title]="supporterTitle"
						[attr.aria-label]="supporterTitle"
						aria-hidden="true"
					)

				.d-none.d-sm-inline([emojiText]="account.name")

					fa-icon.d-inline-block.d-sm-none(
						[icon]="userIcon"
						[title]="account.name"
						[fixedWidth]="true"
						size="lg"
						aria-hidden="true"
					)

					fa-icon.text-danger.account-alert-icon(
						*ngIf="showAccountAlert"
						[icon]="alertIcon"
						[fixedWidth]="true"
						size="sm"
						aria-hidden="true"
					)

				.dropdown-menu.dropdown-menu-right(*dropdownMenu)

					<!-- STATUS -->
					.dropdown-item.d-flex.align-items-center
						.flex-grow-1.mr-3
							fa-icon.mr-2([icon]="userIcon" [fixedWidth]="true")
							| Status:

						.dropdown(dropdown style="width: 65px;")
							button.online-offline.no-highlight.p-0.dropdown-toggle.no-arrow(dropdownToggle)
								fa-icon.mr-2(
									[icon]="plugIcon"
									[fixedWidth]="true"
									[ngClass]="hidden ? 'text-muted' : 'text-success'"
								)
								span.text-success(*ngIf="!hidden")
									| online
								span.text-muted(*ngIf="hidden")
									| offline

							.dropdown-menu.dropdown-menu-right(*dropdownMenu)
								button.dropdown-item((click)="setStatus('online')")
									fa-icon.mr-2.text-success(
										[icon]="statusIcon"
										size="xs"
										[fixedWidth]="true"
									)
									| Online

								button.dropdown-item((click)="setStatus('invisible')")
									fa-icon.mr-2.text-muted(
										[icon]="statusIcon"
										size="xs"
										[fixedWidth]="true"
									)
									| Show as Offline

					<!-- ACCOUNT -->
					a.dropdown-item(
						routerLink="/account"
						(click)="dropdown.close()"
					)
						fa-icon.mr-2([icon]="userCogIcon" [fixedWidth]="true")
						| Account settings

						fa-icon.text-danger.ml-1(
							*ngIf="showAccountAlert"
							[icon]="alertIcon"
						)

					<!-- SETTINGS -->
					button.dropdown-item(
						type="button"
						(click)="openSettings.emit(); dropdown.close()"
					)
						fa-icon.mr-2([icon]="cogIcon" [fixedWidth]="true")
						| Open Settings

					<!-- DIVIDER BEFORE ADMIN -->
					.dropdown-divider(*ngIf="canOpenAdminPanel")

					<!-- ADMIN TOGGLE -->
					button.dropdown-item.d-flex.align-items-center.justify-content-between(
						*ngIf="canOpenAdminPanel"
						(click)="adminExpanded = !adminExpanded"
						type="button"
					)
						.d-flex.align-items-center
							fa-icon.mr-2(
								[icon]="idBadgeIcon"
								[fixedWidth]="true"
							)

							| Admin panel

							span.badge.badge-owner.ml-2
								| admin

						fa-icon.text-muted.ml-2(
							[icon]="adminExpanded ? angleUpIcon : angleDownIcon"
							[fixedWidth]="true"
						)

					<!-- ADMIN EXPANDED ITEMS -->
					a.dropdown-item(
						*ngIf="adminExpanded && canOpenAdminPanel"
						href="/admin"
						(click)="dropdown.close()"
					)
						| State

					a.dropdown-item(
						*ngIf="adminExpanded && canOpenAdminPanel"
						href="/admin/events"
						(click)="dropdown.close()"
					)
						| Events

					a.dropdown-item(
						*ngIf="adminExpanded && canOpenAdminPanel"
						href="/admin/accounts"
						(click)="dropdown.close()"
					)
						| Accounts

					a.dropdown-item(
						*ngIf="adminExpanded && canOpenAdminPanel"
						href="/admin/ponies"
						(click)="dropdown.close()"
					)
						| Ponies

					<!-- DIVIDER BEFORE TOOLS -->
					.dropdown-divider(*ngIf="canOpenAnimatorTools || canOpenArtistStudio || canOpenMapBuilder")

					<!-- TOOLS -->
					a.dropdown-item(
						href="/tools/animation"
						*ngIf="canOpenAnimatorTools"
						(click)="dropdown.close()"
					)
						fa-icon.mr-2([icon]="animatorIcon" [fixedWidth]="true")
						| Animation
						span.badge.badge-dev.ml-2
							| animator

					a.dropdown-item(
						href="/tools/palette"
						*ngIf="canOpenArtistStudio"
						(click)="dropdown.close()"
					)
						fa-icon.mr-2([icon]="artistIcon" [fixedWidth]="true")
						| Sprite palette
						span.badge.badge-dev.ml-2
							| artist

					a.dropdown-item(
						href="/tools/map"
						*ngIf="canOpenMapBuilder"
						(click)="dropdown.close()"
					)
						fa-icon.mr-2([icon]="builderIcon" [fixedWidth]="true")
						| Map Preview
						span.badge.badge-builder.ml-2
							| builder

					.dropdown-divider

					<!-- SIGN OUT -->
					button.dropdown-item((click)="dropdown.close(); openSignOutModal()")
						fa-icon.mr-2([icon]="signOutIcon" [fixedWidth]="true")
						| Sign out


		.text-muted(*ngIf="loading" style="font-size: 20px; padding: 10px 20px;")
			fa-icon([icon]="spinnerIcon" [fixedWidth]="true" [spin]="true")

		form.navbar-form.ml-2(*ngIf="!loading && !account")
			.button-group.dropdown(dropdown)

				button.btn.btn-default.dropdown-toggle.login-register-button(
					dropdownToggle
					[disabled]="!!loadingError"
				)

					fa-icon(
						[icon]="userIcon"
						[fixedWidth]="true"
					)

					span
						| Login & Reg



				.dropdown-menu.dropdown-menu-right(*dropdownMenu)



					.dropdown-header(*ngIf="signUpProviders.length")
						| Log In or Register



					button.dropdown-item.provider-item(
						*ngFor="let p of signUpProviders"
						(click)="signInTo(p)"
						[ngStyle]="{'--provider-color': p.color}"
					)
						span.provider-badge
							| {{p.name}}


					.dropdown-header(*ngIf="signInProviders.length")
						| Log In only


					button.dropdown-item.provider-item.sign-in-only(
						*ngFor="let p of signInProviders"
						(click)="signInTo(p)"
						[ngStyle]="{'--provider-color': p.color}"
					)
						span.provider-badge
							| {{p.name}}