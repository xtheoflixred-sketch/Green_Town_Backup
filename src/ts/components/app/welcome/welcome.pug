//- .welcome-page
.container
	.row.justify-content-center
		.col-xl-8

			.info-alert.mb-4
				.alert.alert-warning(role="alert")

					.header-content
						img.pixelart.server-logo-icon.center(
							revSrc="images/logo-120.png"
							alt="Green Town")

						.header-text
							h1(focusTitle) Welcome to Game!
							p.header-subtitle
								| Play on the custom Green Town server by logging in or creating an account.

					hr.my-3(*ngIf="showLoginWarning")



					fa-icon.mr-1(
						[icon]="warningIcon"
						size="lg")

					strong Важно:

					div([class.collapse]="!showFullWarning" [class.show]="showFullWarning")
						br
						|  Вы входите на основной рабочий билд сервера.

						br
						br

						|  Сервер находится в активной разработке и тестировании, поэтому вы можете столкнуться со следующими проблемами:
						ul.mb-2
							li баги и ошибки в игре
							li нестабильная работа сервера
							li частые перезапуски
							li проблемы со входом в аккаунт или игрой
							li возможная потеря прогресса

						|  Обратите внимание: все обновления применяются напрямую в рабочую версию, так как сервер разрабатывается одним человеком.

						hr

						fa-icon.mr-1([icon]="warningIcon" size="lg")
						strong Notice:
						|  You are entering the main development build of the server.

						br
						br

						|  The server is actively being developed and tested, so you may encounter:
						ul.mb-2
							li bugs and glitches
							li unstable performance
							li frequent restarts
							li login or account issues
							li possible data loss

						|  Please note: updates are applied directly to the live build, as the server is maintained by a single developer.

						br
						br

						|  By continuing, you acknowledge and accept these conditions.

				// toggle full warning button (uses same logic as old sign-in-box)
				button.btn.btn-sm.btn-light(type="button" (click)="toggleFullWarning()" [attr.aria-expanded]="showFullWarning" aria-controls="warningText")
					| {{ showFullWarning ? 'Show Less...' : 'Show More...' }}



			.account-info-block

				section.mb-4
					h2 Account access

					p.text-muted.mb-3
						| Select one of the supported providers below to register or log in.



				.row


					.col-12.mb-4
						.provider-panel

							h3 Registration

							p.text-muted.mb-3
								| Choose a provider to create an account.



							.sign-in-box-providers.text-center


								button.btn.btn-lg.btn-dark.provider-button(
									*ngFor="let p of signUpProviders"
									type="button"
									(click)="signIn(p)"
									[class.disabled]="p.disabled"
									[style.border-bottom-color]="p.color"
									title="Sign in using {{p.name}}"
								)

									span.provider-icon-box(
										[style.background]="p.color"
									)

										fa-icon(
											[icon]="icon(p.id)"
											[fixedWidth]="true"
											size="lg"
										)


									span.provider-text
										| {{p.name}}





					.col-12.mb-4(*ngIf="signInProviders.length")

						.provider-panel


							h3 Log In


							p.text-muted.mb-3
								| These providers only work for existing accounts.



							.sign-in-box-providers.sign-in-only.text-center



								button.btn.btn-lg.btn-dark.provider-button(
									*ngFor="let p of signInProviders"
									type="button"
									(click)="signIn(p)"
									[class.disabled]="p.disabled"
									[style.border-bottom-color]="p.color"
									title="Sign in using {{p.name}}"
								)


									span.provider-icon-box(
										[style.background]="p.color"
									)

										fa-icon(
											[icon]="icon(p.id)"
											[fixedWidth]="true"
											size="lg"
										)



									span.provider-text
										| {{p.name}}





				section.text-center.mt-4

					.provider-panel


						h3 Development Tools


						p.text-muted.mb-3
							| Use a test account to enter the server.



						.sign-in-box-providers


							button.btn.btn-lg.btn-dark(
								type="button"
								(click)="onMockLogin()"
							)

								| Mock Login



						mock-login-modal(
							[accounts]="mockAccounts"
							[show]="showMockLogin"
							(close)="onMockLoginClose()"
							(login)="onMockLoginSubmit($event)"
							(create)="onMockCreateAccount($event)"
						)