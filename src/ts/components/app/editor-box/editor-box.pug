.d-flex.flex-column.align-items-start

	// Верхний ряд
	.d-flex.flex-row.align-items-start
		button.game-button.px-2((click)="toggleEditor()")
			fa-icon([icon]="editIcon")

		// Остальной редактор
		.d-flex.align-items-start.pl-2.pt-1(*ngIf="hasEditor")
			.dropdown-menu.p-0(
				*ngIf="hasSelectedEntities"
				style="display: block; width: 380px; position: absolute; top: 36px; left: 0;")
				.px-2

				//- name
				div
					.row.form-group.mb-2
						label.col-12.col-form-label
							.float-right
								button.btn.btn-xs.btn-warning.ml-1(
									(click)="holdSelectedItem()"
									title="Hold item")
									| Hold

								button.btn.btn-xs.btn-warning.ml-1(
									(click)="becomeSelectedItem()"
									title="Become (teleport to entity)")
									| Become

								button.btn.btn-xs.btn-dark.ml-1(
									(click)="showEntitiesInfo()"
									title="Show info")
									| info

								button.btn.btn-xs.btn-secondary.ml-1(
									(click)="duplicateEntities()"
									title="Duplicate entities")
									fa-icon([icon]="duplicateIcon")

								button.btn.btn-xs.btn-danger.ml-1(
									(click)="deleteEntities()"
									title="Delete entities")
									fa-icon([icon]="deleteIcon")

							| {{entityName}}

					//- position
					div(*ngIf="singleEntity")
						.row.form-group.mb-2
							label.col-4.col-form-label
								| position

							label.col-1.col-form-label
								| x

							.col-3
								input.form-control(
									[(ngModel)]="entityX"
									type="number")

							label.col-1.col-form-label
								| y

							.col-3
								input.form-control(
									[(ngModel)]="entityY"
									type="number")

					//- light
					div(*ngIf="isLightEntity")
						.row.form-group.mb-2
							label.col-5.col-form-label
								| light color

							.col-7
								color-picker([(color)]="entityLightColor")

						.row.form-group.mb-2
							label.col-5.col-form-label
								| light scale ({{entityLightScale | number:'0.1-1'}})

							.col-7.py-2
								slider-bar(
									[(value)]="entityLightScale"
									[min]="0"
									[max]="3")

					//- light sprite
					div(*ngIf="isLightSpriteEntity")
						.row.form-group.mb-2
							label.col-5.col-form-label
								| light sprite color

							.col-7
								color-picker([(color)]="entityLightSpriteColor")

						.row.form-group.mb-2
							label.col-4.col-form-label
								| light sprite

							label.col-1.col-form-label
								| x

							.col-3
								input.form-control(
									[(ngModel)]="entityLightSpriteX"
									type="number")

							label.col-1.col-form-label
								| y

							.col-3
								input.form-control(
									[(ngModel)]="entityLightSpriteY"
									type="number")

				//- custom image controls — DISABLED
				//- div(*ngIf="isCustomImageEntity")
				//- 	.row.form-group.mb-2
				//- 		label.col-5.col-form-label
				//- 			| image
				//- 		.col-7
				//- 			.input-group.input-group-sm
				//- 				input.form-control(
				//- 					[(ngModel)]="entityCustomImageUrl"
				//- 					placeholder="image url"
				//- 					readonly)
				//- 				.input-group-append
				//- 					label.btn.btn-sm.btn-secondary.mb-0(
				//- 						style="cursor:pointer")
				//- 						| upload
				//- 						input(
				//- 							type="file"
				//- 							accept="image/*,.psd"
				//- 							style="display:none"
				//- 							(change)="onImageFileSelected(fileInput.files[0])")
				//- 	.row.form-group.mb-2
				//- 		label.col-5.col-form-label
				//- 			| scale ({{entityCustomImageScale | number:'1.0-2'}})
				//- 		.col-7.py-2
				//- 			slider-bar(
				//- 				[(value)]="entityCustomImageScale"
				//- 				[min]="0.1"
				//- 				[max]="5")
				//- 	.row.form-group.mb-2
				//- 		label.col-5.col-form-label
				//- 			| opacity ({{entityCustomImageOpacity | number:'1.0-2'}})
				//- 		.col-7.py-2
				//- 			slider-bar(
				//- 				[(value)]="entityCustomImageOpacity"
				//- 				[min]="0"
				//- 				[max]="1")
				//- 	.row.form-group.mb-2
				//- 		label.col-5.col-form-label
				//- 			| layer
				//- 		.col-7
				//- 			select.form-control(
				//- 				[(ngModel)]="entityCustomImageZOrder")
				//- 				option(value="below") Below players
				//- 				option(value="above") Above players

				//- entity info box
				div(*ngIf="singleEntity")
					.row.form-group.mb-2
						label.col-4.col-form-label name
						.col-8
							input.form-control([(ngModel)]="entityNameInput" maxlength="30")
					.row.form-group.mb-2
						label.col-4.col-form-label message color
						.col-8
							color-picker([(color)]="entityMessageColor" openUp="true")
					.row.form-group.mb-2
						label.col-4.col-form-label message
						.col-8
							textarea.form-control([(ngModel)]="entityMessageInput" rows="2" maxlength="100")
					.row.form-group.mb-2
						.col-12.text-right
							button.btn.btn-xs.btn-warning((click)="saveEntityName()")
								| Save

				//- tint color (always)
				div(*ngIf="singleEntity")
					.row.form-group.mb-2
						label.col-5.col-form-label tint color
						.col-4
							color-picker([(color)]="entitySpriteTint")
						.col-3.text-right
							button.btn.btn-xs.btn-warning((click)="entitySpriteTint = '#ffffff'") default

				//- selection highlight color
				div(*ngIf="singleEntity")
					.row.form-group.mb-2
						label.col-5.col-form-label highlight
						.col-4
							color-picker([(color)]="selectionHighlightColor")
						.col-3.text-right
							button.btn.btn-xs.btn-warning((click)="selectionHighlightColor = '#ffcc00'") default

				//- scale (non-customImage only)
				div(*ngIf="singleEntity && !isCustomImageEntity")
					.row.form-group.mb-2
						label.col-5.col-form-label scale ({{entityScale | number:'1.0-2'}})
						.col-4.py-2
							slider-bar([(value)]="entityScale" [min]="0.1" [max]="5")
						.col-3.text-right
							button.btn.btn-xs.btn-warning((click)="entityScale = 1") default

				//- opacity (non-customImage only)
				div(*ngIf="singleEntity && !isCustomImageEntity")
					.row.form-group.mb-2
						label.col-5.col-form-label opacity ({{entityOpacity | number:'1.0-2'}})
						.col-4.py-2
							slider-bar([(value)]="entityOpacity" [min]="0" [max]="1")
						.col-3.text-right
							button.btn.btn-xs.btn-warning((click)="entityOpacity = 1") default

			.input-group.input-group-sm
				input.form-control(
					[(ngModel)]="editorEntity"
					placeholder="entity")

			.input-group-append
				button.btn.btn-default(
					type="button"
					(click)="openEntityPicker()")
					| objects

			.dropdown.ml-1(dropdown)
				button.btn.btn-sm.btn-default.dropdown-toggle(dropdownToggle)
					fa-icon([icon]="cogIcon")

				.dropdown-menu(*dropdownMenu)
					a.dropdown-item((click)="clearLocalStorage()")
						| Clear local storage

					a.dropdown-item(
						(click)="editorClear()"
						title="Remove all placed entities")
						| Clear all entities

					a.dropdown-item(
						(click)="listEntities()"
						title="List all placed entities in console")
						| List entities

					div(*ngIf="dev")
						h6.dropdown-header Show (numpad 4)

						a.dropdown-item(
							*ngFor="let item of showFields"
							(click)="toggleShow(item.field); $event.stopPropagation()")
							fa-icon.mr-1(
								[icon]="isShow(item.field) ? checkIcon : emptyIcon"
								[fixedWidth]="true")
							| {{item.label}}

			button.btn.btn-sm.btn-default.ml-1(
				[btnHighlight]="selectingEntities"
				(click)="toggleSelecting()"
				title="Select entities")
				fa-icon([icon]="selectIcon")

			//- CUSTOM_IMAGES_DISABLED: upload button
			//- button.btn.btn-sm.btn-default.ml-1(
			//- 	(click)="fileInput.click()"
			//- 	title="Upload custom image")
			//- 	fa-icon([icon]="uploadIcon")
			//- input.d-none(
			//- 	#fileInput
			//- 	type="file"
			//- 	accept="image/*,.psd"
			//- 	(change)="onImageFileSelected(fileInput.files[0])")

			.dropdown.ml-1(dropdown)
				button.btn.btn-sm.btn-default.dropdown-toggle(dropdownToggle)
					| tile: {{tiles[editorTile]}}

				.dropdown-menu(*dropdownMenu)
					a.dropdown-item(
						*ngFor="let t of tiles; let i = index"
						(click)="editorTile = i")
						| {{t}}

			//.dropdown.ml-1(dropdown)
				button.btn.btn-sm.btn-default.dropdown-toggle(dropdownToggle)
					| brush: {{editor.brushSize}}

				.dropdown-menu(*dropdownMenu)
					a.dropdown-item((click)="editor.brushSize = 1") 1
					a.dropdown-item((click)="editor.brushSize = 2") 2
					a.dropdown-item((click)="editor.brushSize = 3") 3
					a.dropdown-item((click)="editor.brushSize = 4") 4
					a.dropdown-item((click)="editor.brushSize = 5") 5
					a.dropdown-item((click)="editor.brushSize = 6") 6

			//.dropdown.ml-1(dropdown [autoClose]="false")
				button.btn.btn-sm.btn-default.dropdown-toggle(dropdownToggle)
					| global

				.dropdown-menu(*dropdownMenu style="width: 400px")
					button(style="display: block; width: 0; height: 0;")

					.px-2
						.row.form-group
							label.col-5.col-form-label.d-flex.justify-content-between
								| light color

								custom-checkbox([(checked)]="editor.customLight")

							.col-7
								color-picker(
									[(color)]="editor.lightColor"
									[isDisabled]="!editor.customLight")

						.row.form-group.mb-0
							label.col-5.col-form-label
								| shadow opacity ({{shadowOpacity}})

							.col-7.py-2
								slider-bar(
									[(value)]="shadowOpacity"
									[min]="0"
									[max]="255")

			//.dropdown.ml-1(dropdown)
				button.btn.btn-sm.btn-default.dropdown-toggle(dropdownToggle)
					| engine

				.dropdown-menu(*dropdownMenu)
					a.dropdown-item(
						*ngFor="let e of engines"
						(click)="setEngine(e)"
						[class.active]="isActiveEngine(e)")
						| {{e.name}}

			//.btn.btn-sm.btn-default.disabled.ml-1(*ngIf="hasElevation")
				| elevation: {{editorElevation}}

			//.btn.btn-sm.btn-default.disabled.ml-1(*ngIf="hasElevation")
				| special: {{editorSpecial}}

	// Нижний ряд — инструменты
	.editor-tools-panel.mt-2(*ngIf="hasEditor")
		.form-group.d-flex.align-items-center.mb-2
			.btn-group

				button.btn.btn-sm(
					[class.btn-success]="useEditorHammer"
					[class.btn-default]="!useEditorHammer"
					(click)="useEditorHammer = !useEditorHammer"
					title="Editor hammer — add/place any object (LMB)")
					fa-icon([icon]="hammerIcon")

				button.btn.btn-sm(
					[class.btn-primary]="useEditorShovel"
					[class.btn-default]="!useEditorShovel"
					(click)="useEditorShovel = !useEditorShovel"
					title="Editor shovel — edit tiles (LMB)")
					fa-icon([icon]="shovelIcon")
					//span.badge.badge-dark {{editor.brushSize}}

				button.btn.btn-sm(
					[class.btn-danger]="useEditorBroom"
					[class.btn-default]="!useEditorBroom"
					(click)="useEditorBroom = !useEditorBroom"
					title="Editor broom — remove any entity (LMB)")
					fa-icon([icon]="broomIcon")

				button.btn.btn-sm(
					[class.btn-warning]="useEditorRope"
					[class.btn-default]="!useEditorRope"
					(click)="useEditorRope = !useEditorRope"
					title="Editor rope — move any entity (drag)")
					fa-icon([icon]="ropeIcon")

				button.btn.btn-sm(
					[class.btn-info]="useEditorPickaxe"
					[class.btn-default]="!useEditorPickaxe"
					(click)="useEditorPickaxe = !useEditorPickaxe"
					title="Editor pickaxe — clone any entity (Ctrl+drag)")
					fa-icon([icon]="pickaxeIcon")

				button.btn.btn-sm(
					[class.btn-secondary]="useEditorSaw"
					[class.btn-default]="!useEditorSaw"
					(click)="useEditorSaw = !useEditorSaw"
					title="Editor saw — toggle walls anywhere")
					fa-icon([icon]="sawIcon")

				button.btn.btn-sm(
					[class.btn-light]="useEditorScrap"
					[class.btn-default]="!useEditorScrap"
					(click)="useEditorScrap = !useEditorScrap"
					title="Editor scrap — mirror objects")
					fa-icon([icon]="scrapIcon")

				button.btn.btn-sm(
					[class.btn-info]="useEditorRecolor"
					[class.btn-default]="!useEditorRecolor"
					(click)="useEditorRecolor = !useEditorRecolor"
					title="Recolor — cycle colors of furniture")
					fa-icon([icon]="recolorIcon")

				button.btn.btn-sm(
					[class.btn-success]="useEditorSeason"
					[class.btn-default]="!useEditorSeason"
					(click)="useEditorSeason = !useEditorSeason"
					title="Season — cycle seasons of objects")
					fa-icon([icon]="seasonIcon")

ng-template(#entityPickerModal)
	.modal-header.d-sm-block
		h4.modal-title.d-flex.justify-content-between.w-100
			| Select object

			button.px-2(
				type='button'
				aria-label='Close'
				(click)='closeEntityPicker()')
				span(aria-hidden='true') ×

	.modal-body.text-large.editor-entity-modal-body
		.form-group.mb-2
			.input-group
				input.form-control(
					type='text'
					[ngModel]='entitySearch'
					(ngModelChange)='onEntitySearchChange($event)'
					placeholder='Search object...')

				.input-group-append(*ngIf='entitySearch')
					button.btn.btn-default.editor-search-clear(
						type='button'
						(click)='clearEntitySearch()'
						aria-label='Clear search')
						| ×

		.editor-entity-list
			ng-container(*ngFor='let e of filteredEditorEntities; let last = last')

				div.dropdown-item.editor-entity-item(
					#entityItemButton
					[attr.data-entity]='e'
					(click)='selectEditorEntity(e)'
					role='button'
					tabindex='0'
					[class.active]='e === pendingEditorEntity')

					.editor-entity-main
						span.editor-entity-icon
							action-button(
								[action]='getEntityPreviewAction(e)'
								[shadow]='false')

						span.editor-entity-name(
							[class.search-highlight]='entitySearch && e === pendingEditorEntity')
							| {{e}}

					span.editor-entity-status(
						*ngIf='e === pendingEditorEntity')
						| selected

				hr.editor-entity-separator(*ngIf='!last')

			div.text-muted.px-2.py-2(*ngIf='!filteredEditorEntities.length')
				| No objects found

	.modal-footer.d-flex
		.div(class='flex-grow-1 text-muted pl-1')
			| Chosen: {{pendingEditorEntity || 'none'}}

		button.btn.btn-outline-secondary.mr-2(
			type='button'
			(click)='closeEntityPicker()')
			| Close

		button.btn.btn-primary(
			type='button'
			(click)='applyEditorEntity()'
			[disabled]='!pendingEditorEntity')
			| Apply
