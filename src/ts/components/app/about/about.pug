.page-header-about
	.header-content
		img.pixelart.server-logo-icon(revSrc="images/logo-120.png" alt="Server Logo")
		.header-text
			h1(focusTitle) About
			p.header-subtitle A Pony Town custom server

.row.text-large
	.col-lg-7
		section
			h2.text-center Project Description
			.text-muted.mb-3 Server Information:
			p.text-center Green Town is a cozy rolleplaying where ponies enjoi adventuries and relax in the modern forest camp! 
			p 
			p.text-muted This is a personal project focused on improving the visual side of the game and making it more comfortable for players. The server is based on an older Pony Town build (version 0.55.2 from 2019), enhanced with useful additions that make gameplay more convenient. 
			hr

		p.text-muted This game is a derivative work based on #[a(href="https://pony.town") Pony Town]. The developers of Pony Town are not responsible for it in any way and do not support it. This project is not affiliated with the original Pony Town team. All rights to the original game belong to its creators. You can find more details on the Pony Town Wiki, which is a community-driven resource for information about the game. The wiki contains a wealth of information about the game's mechanics, features, and lore, and is a great place to learn more about the world of Pony Town.

		h2.text-center#socials Contacts and Community

		section
			h4.mb-2#telegram Telegram
			p Our #[b Telegram channel] is the main place for #[i short updates], spoilers, concepts, and internal development news. Telegram is also where we communicate directly with players.
			telegram-button.mb-3
			hr

		section 
			h4.mb-2#tiktok TikTok
			p Our #[b TikTok channel] is the main place for #[i short updates], spoilers, concepts, and internal development news. TikTok is also where we communicate directly with players.
			tiktok-button.mb-3
			hr

		section
			h4.mb-2#PT Original Pony Town Server
			p This project is based on the original #[b Pony Town] build. We recommend checking out the official server as well, since it is the foundation of our world.
			p If you are interested in the classic experience, be sure to visit the official Pony Town server.
			visit-pt-button.mb-3
			hr


		p.text-muted For questions, suggestions, or inquiries, please reach out to us through our Telegram channel or TikTok. We value your feedback and are always happy to hear from our community.
		
		h2 Technology

		p.
			The entire game is written in #[a(href="http://www.typescriptlang.org/") TypeScript],
			a typed superset of JavaScript that compiles to plain JavaScript.
			Server side code is running on #[a(href="https://nodejs.org/en/") Node.js]
			server with WebSockets for communication.
			User interface is built using #[a(href="https://angular.io/") Angular]
			framework and the game itself is using WebGL for rendering graphics.

		strong Game Version: 
			| {{  version }}

		div(*ngIf="credits.length")
			h2 The Team
			.mb-4
				.team-members.web-tab
					.team-member.team.mt-2(*ngFor="let c of credits" [class.single-badge-card]="c.badges.length === 2")
						.team-member-inner
							.team-avatar-wrap
								.team-avatar(
									[style.background-color]="c.backgroundColor"
									[style.background-position]="c.position"
									style="background-size: cover; width: 100px; height: 100px; position: relative;"
									(mouseenter)="ponyExcite(characterPreview)"
									(mouseleave)="ponyReset(characterPreview)"
								)
									.avatar-pony
										team-pony(#characterPreview [pony]="c.pony")

								.text-center(style="margin-top:6px;")
									.d-flex.name-links.align-items-center.justify-content-center
										b.text-truncate.sno.mb-0 {{c.name}}
										site-links([links]="c.links")

								.team-badges-col(*ngIf="c.badges.length === 1")
									span.badge(
										[style.background-color]="c.badges[0].color"
										style="color:white;border-radius:4px;padding:3px 8px;margin-bottom:6px;font-size:11px;white-space:nowrap;"
									)
										ng-container(*ngIf="c.badges[0].icon")
											fa-icon([icon]="c.badges[0].icon" size="xs")
										| {{c.badges[0].label}}

							.team-badges-col(*ngIf="c.badges.length > 1")
								span.badge(
									*ngFor="let badge of c.badges"
									[style.background-color]="badge.color"
									style="color:white;border-radius:4px;padding:3px 8px;margin-bottom:6px;font-size:11px;white-space:nowrap;"
								)
									ng-container(*ngIf="badge.icon")
										fa-icon([icon]="badge.icon" size="xs")
									| {{badge.label}}

		h2 Contributors

		div(*ngFor="let g of contributors")
			h3 {{g.group}}
			p(*ngFor="let c of g.contributors")
				strong {{c.name}}
				span(*ngIf="c.links")
					| -
					site-links([links]="c.links")

	.col-lg-5
		h2 Changelog

		.update-about
			.image-box(style="background:url('/assets/images/update_previews/season1.png') center/cover;")
			.about-text
				p Welcome to a new update!

		changelog-view(*ngIf="changelogResponse" [rawEntries]="changelogResponse.public")

			hr

			h2 Dev Changelog
			changelog-view(*ngIf="changelogResponse && changelogResponse.dev && changelogResponse.dev.length > 0 && isPrivileged" [rawEntries]="changelogResponse.dev")

.text-center.text-muted
	.tinyface#tinyFaceAbout((mouseenter)="onTinyFaceEnter()" (mouseleave)="onTinyFaceLeave()")