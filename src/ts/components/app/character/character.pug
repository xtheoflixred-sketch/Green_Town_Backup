										strong.ml-1 {{ supporterTagLabel }}

									.dropdown-menu(*dropdownMenu)
										a.dropdown-item((click)="pony.supportTag = undefined; pony.hideSupport = false") Auto

										a.dropdown-item((click)="pony.supportTag = 'hidden'; pony.hideSupport = true")
