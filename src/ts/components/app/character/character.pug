										[class]="info.hearts ? 'btn btn-primary' : 'btn btn-default'"
										(click)="toggleHeartsEffect()"
										[tooltip]="'Toggle hearts effect'"
										aria-label="Hearts effect"
									)
										| HEARTS

									button(
										type="button"
										[class]="info.magic ? 'btn btn-primary' : 'btn btn-default'"
