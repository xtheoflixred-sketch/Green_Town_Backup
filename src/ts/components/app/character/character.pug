										[tooltip]="'Toggle sleeping effect'"
										aria-label="Sleeping effect"
									)
										| ZZZ

									button(
										type="button"
										[class]="info.tears ? 'btn btn-primary' : 'btn btn-default'"
										(click)="toggleTearsEffect()"
										[tooltip]="'Toggle tears effect'"
										aria-label="Tears effect"
									)
										| TEARS

									button(
