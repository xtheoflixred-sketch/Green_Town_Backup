										a.dropdown-item(*ngIf="model.supporter >= 2" (click)="pony.supportTag = 'sup2'; pony.hideSupport = false")
											fa-icon.supporter-2.mr-1([icon]="starIcon")
											| Bronze (tier 2)

										a.dropdown-item(*ngIf="model.supporter >= 3" (click)="pony.supportTag = 'sup3'; pony.hideSupport = false")
											fa-icon.supporter-3.mr-1([icon]="starIcon")
											| Gold (tier 3)

										a.dropdown-item(*ngIf="model.supporter >= 4" (click)="pony.supportTag = 'sup4'; pony.hideSupport = false")
											fa-icon.supporter-4.mr-1([icon]="starIcon")
											| Emerald (tier 4)



					.row.form-group
						label#supporter-chat-label.col-sm-4.col-form-label Select chat

						.col-sm-8
							.dropdown.btn-group(dropdown)
								button.btn.btn-default.dropdown-toggle(
									dropdownToggle
									aria-labelledby="supporter-chat-label"
								)
									| {{ supportChatLabel }}

								.dropdown-menu(*dropdownMenu)
									a.dropdown-item((click)="pony.supportChat = undefined") Auto

									a.dropdown-item(*ngFor="let option of supportChatOptions"
										(click)="pony.supportChat = option.id")
										| {{ option.label }}

					.row.form-group
						label.col-sm-4.col-form-label Display sup tag

						.col-sm-8
							custom-checkbox([(checked)]="supportTagPriority")
