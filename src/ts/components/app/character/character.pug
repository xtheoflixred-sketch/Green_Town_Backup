ng-template(#unsavedCharacterModal)

	unsaved-character-modal(

		[title]="modalTitle"

		[prompt]="modalPrompt"

		[saveLabel]="modalSaveLabel"

		[discardLabel]="modalDiscardLabel"

		[ponyName]="modalPonyName"

		[currentPonyData]="pony"

		[currentPony]="pony.ponyInfo"

		[storedPonyData]="modalContext === 'restore' ? restoreDraftCandidate : storedPony"

		[storedPony]="modalContext === 'restore' ? restoreDraftCandidate?.ponyInfo : storedPonyInfo"

		(save)="confirmSaveAndPlay()"

		(discard)="confirmDiscardAndPlay()"

		(cancel)="cancelPlay()"

	)


ng-template(#importedCharacterModal)

	imported-modal(

		[ponies]="importedPonies"

		[account]="model.account"

		[errorMessage]="importError"

		(close)="closeImportedCharacterModal()"

		(keep)="confirmImportedCharacter()"

		(remove)="closeImportedCharacterModal()"

	)

